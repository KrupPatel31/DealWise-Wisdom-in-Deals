# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/dealwise_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dealwise_db
DB_USER=your_username
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-min-32-chars
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-here-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://your-app.lovable.app

# Resend Email Service (https://resend.com)
# Sign up at resend.com and get your API key
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=DealWise <noreply@yourdomain.com>

# Security
COOKIE_SECRET=your-secure-cookie-secret-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5